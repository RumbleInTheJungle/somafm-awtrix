# @name     SomaFM Radio
# @desc     Listen to SomaFM on the clock's own speaker. Turn the knob to pick a channel, press it for volume, hold it for a favourite. Unofficial hobby project, not affiliated with or endorsed by SomaFM but used with their permission.
# @author   Thomas
# @version  2.0.0
# @display  52x16
# @config   idlecard  bool   "Show when radio is off" default=true help="Short turn in the rotation while the radio is off, so you can start it with the knob."
#
# Unofficial hobby project, not affiliated with or endorsed by SomaFM but used
# with their permission. SomaFM's streams and JSON files are not a free data
# feed, and the permission doesn't carry over to forks or other projects. Read
# their terms first: https://somafm.com/contact/tos.html (see also NOTICE.md).

import string

var sf = module("somafm")

# ---------------------------------------------------------------------------
# Identifies this project to SomaFM, at their request, so it doesn't get blocked
# by mistake. IF YOU FORK THIS CODE, change it to your own project's name and
# address, and get your own permission from SomaFM.
# ---------------------------------------------------------------------------
sf.USER_AGENT = "somafm-awtrix/2.0 (+https://github.com/RumbleInTheJungle/somafm-awtrix)"

# ---------------------------------------------------------------------------
# Palette: SomaFM's web colours (black, #EEE, amber #D8A24D, teal #1A9096),
# pushed a little more saturated so they don't wash out to beige on LEDs.
# ---------------------------------------------------------------------------
sf.WHITE = 0xEBEBEB   # primary text: channel names, song titles
sf.AMBER = 0xFFA830   # accent: channel name (now playing), "playing", favourites, cursor
sf.TEAL  = 0x20B8C0   # secondary accent: volume / system feedback
sf.GREY  = 0x6E6E6E   # secondary text: genre, "tuning", "retrying"
sf.TRACK = 0x202020   # inactive track of the position / volume bar
sf.OFF   = 0xB4B4B4   # colour bar for channels without a signature colour

# BEGIN CHANNELS
# Generated by tools/gen_channels.py on 2026-11-04 (51 channels). Do not edit by hand.
# [id, title, genre, signature colour]
sf.CHANNELS = [
  ["beatblender", "Beat Blender", "electronic", 0xF434FF],
  ["brfm", "Black Rock FM", "eclectic", 0xFF9B66],
