  ["specials", "SomaFM Specials", "specials", 0xFF7C55],
  ["sonicuniverse", "Sonic Universe", "jazz", 0xFF8235],
  ["spacestation", "Space Station Soma", "electronic", 0xFF9D5C],
  ["suburbsofgoa", "Suburbs of Goa", "world", 0xFFBF0E],
