# END CHANNELS

# 5x5 star, as x,y pairs
sf.STAR = [2,0, 1,1, 2,1, 3,1, 0,2, 1,2, 2,2, 3,2, 4,2, 1,3, 2,3, 3,3, 1,4, 3,4]

# ---------------------------------------------------------------------------
# Lookups
# ---------------------------------------------------------------------------

# Index of the row whose first element is `id` in a table, or -1.
sf.index_of = def (tbl, id)
  if id == nil return -1 end
  var i = 0
  while i < size(tbl)
    if tbl[i][0] == id return i end
    i += 1
  end
  return -1
end

# Index of a plain value in a list, or -1.
sf.pos = def (lst, v)
  var i = 0
  while i < size(lst)
    if lst[i] == v return i end
    i += 1
  end
  return -1
end

# Built-in row [id, title, genre, colour] or nil.
sf.channel = def (id)
  var i = sf.index_of(sf.CHANNELS, id)
  return i >= 0 ? sf.CHANNELS[i] : nil
end

sf.color = def (id)
  var c = sf.channel(id)
  return c != nil ? c[3] : sf.OFF
end

sf.title = def (id)
  var c = sf.channel(id)
  if c != nil return c[1] end
  return id != nil ? id : "SomaFM"
end

# MP3 playlist (128k). AWTRIX plays the first stream of a .pls and re-reads
# the playlist on reconnect, so it fails over between SomaFM's ice servers.
# Used with SomaFM's permission. The firmware makes this request itself, and its
# docs have no option for the User-Agent, so USER_AGENT doesn't apply to it.
sf.stream_url = def (id)
  return "https://api.somafm.com/" + id + ".pls"
end

# True if `needle` ("/" + id) occurs in s and is not followed by a letter,
# so "/live" doesn't match "/liveradio" (digits may follow: "u80s512.png").
sf.has_id = def (s, needle)
  var p = string.find(s, needle)
  while p >= 0
    var e = p + size(needle)
    if e >= size(s) return true end
    var ch = s[e]
    if !(ch >= "a" && ch <= "z") && !(ch >= "A" && ch <= "Z") return true end
    p = string.find(s, needle, p + 1)
  end
  return false
end

# Channel id from what music.station() reports. Logged on the device: the URL
# we tuned (https://api.somafm.com/groovesalad.pls). Other forms are handled
# defensively, including the logo URL streams send as ICY StreamUrl; whether
# the firmware ever reports that one is unconfirmed. Looks for a known channel
# id right after a "/" and takes the longest hit (so "groovesalad2512.png" is
# groovesalad2, not groovesalad):
#   https://api.somafm.com/groovesalad.pls        -> groovesalad
#   https://ice2.somafm.com/groovesalad-128-mp3   -> groovesalad
#   https://somafm.com/logos/512/u80s512.png      -> u80s
# Falls back to the channel title (station names like "Groove Salad: ...").
# `tbl` is a table of rows starting with [id, title, ...]; default: built-in.
# Returns nil for anything that isn't a known SomaFM channel.
sf.id_from_station = def (s, tbl)
  if s == nil || s == "" return nil end
  if string.find(s, "somafm") < 0 && string.find(s, "SomaFM") < 0 return nil end
  if tbl == nil tbl = sf.CHANNELS end
  var best = nil
  for c : tbl
    var id = c[0]
    if (best == nil || size(id) > size(best)) && sf.has_id(s, "/" + id)
      best = id
    end
  end
  if best != nil return best end
  var blen = 0
  for c : tbl
    var t = c[1]
    if size(t) > blen && string.find(s, t) >= 0
      best = c[0]
      blen = size(t)
    end
  end
  return best
end

# "id1,id2,id3" -> list. Only for favourites saved by version 1.
sf.split_csv = def (s)
  var out = []
  if s == nil || s == "" return out end
  var p = 0
  while true
    var e = string.find(s, ",", p)
    if e < 0
      if p < size(s) out.push(s[p .. size(s) - 1]) end
      break
    end
    if e > p out.push(s[p .. e - 1]) end
    p = e + 1
  end
  return out
end

# ---------------------------------------------------------------------------
# Online channel list (channels.json is ~58 KB). Scans the body with
# string.find instead of json.load, so the whole document is never built
# in memory. Returns [[id, title, first_genre], ...] in SomaFM's order.
# ---------------------------------------------------------------------------

# Next `"key": "value"` at or after `from` -> [value, position_after], or nil.
sf.json_field = def (s, key, from)
  var k = "\"" + key + "\""
  var p = string.find(s, k, from)
  if p < 0 return nil end
  p = string.find(s, "\"", p + size(k))      # opening quote of the value
  if p < 0 return nil end
  var e = string.find(s, "\"", p + 1)        # closing quote
  if e < 0 return nil end
  var v = e > p + 1 ? s[p + 1 .. e - 1] : ""
  return [v, e + 1]
end

sf.parse_channels = def (body)
  var rows = []
  var pos = 0
  while true
    var fid = sf.json_field(body, "id", pos)
    if fid == nil break end
    var ftitle = sf.json_field(body, "title", fid[1])
    if ftitle == nil break end
    var fgenre = sf.json_field(body, "genre", ftitle[1])
    if fgenre == nil break end
    var g = fgenre[0]
    var bar = string.find(g, "|")
    if bar > 0 g = g[0 .. bar - 1] end
    rows.push([fid[0], ftitle[0], g])
    pos = fgenre[1]
  end
  return rows
end

# ---------------------------------------------------------------------------
# Drawing helpers (call only from draw())
# ---------------------------------------------------------------------------

# Three audio-reactive bars, 1 px wide with 1 px gaps, `h` rows tall.
sf.draw_eq = def (x, ytop, h, color)
  var b = music.bands(3, h)
  var i = 0
  while i < 3
    var v = int(b[i])
    if v < 1 v = 1 end
    if v > h v = h end
    rect_fill(x + i * 2, ytop + h - v, 1, v, color)
    i += 1
  end
end

sf.draw_star = def (x, y, color)
  var i = 0
  while i < size(sf.STAR)
    pixel(x + sf.STAR[i], y + sf.STAR[i + 1], color)
    i += 2
  end
end

# The view:
#   EQ bars (channel colour) | channel name (accent), small font, rows 1-5
#   "Artist - Title" (white), small font, rows 9-13
sf.draw_now = def (l1, c1, l2, c2, eqcol, o1, o2)
  var w = width()
  sf.draw_eq(0, 1, 5, eqcol)
  font("small")
  scroll_text(7, 6, w - 7, l1, c1, o1)
  scroll_text(0, 14, w, l2, c2, o2)
end

# ---------------------------------------------------------------------------
# The app is one view and one list: Radio off, favourites, all channels.
#   Knob turn   move through the list; what you stop on plays after 600 ms
#   Knob press  turning sets the volume, until 2 s without input
#   Knob hold   add or remove the favourite
# The position bar and star show for 5 s after the last input, and the rotation
# waits for that long. Radio off is a place in the list like any channel.
# ---------------------------------------------------------------------------

var OFF_ITEM = "off"

class SomaFM
  var chans, favs, items, cur, active, vol_mode, vol, last_input, knob_long, zap_timer
  var tuned, tune_ms, old_raw, st
  var l1, l2, l2col, eqcol, toast, toast_until, o1, o2, idlecard
  var s_off, s_hint, s_nosignal

  def init()
    var show = store.get("idlecard")
    self.idlecard = show == nil ? true : show

    # Version 1 kept its favourites as "id1,id2,id3".
    var f = store.get("favs")
    if isinstance(f, list)
      self.favs = f
    else
      self.favs = type(f) == "string" ? sf.split_csv(f) : []
    end

    self.s_off = settings.apply_case("Radio off")
    self.s_hint = settings.apply_case("turn knob")
    self.s_nosignal = settings.apply_case("no signal")
    self.o1 = {}
    self.o2 = {"repeat": 1}     # keep the card up until the title has run through once

    self.items = [OFF_ITEM]
    self.cur = 0
    self.active = false
    self.vol_mode = false
    self.vol = 50
    self.last_input = 0
    self.knob_long = false
    self.zap_timer = nil
    self.tuned = nil            # channel being tuned, until its stream takes over
    self.tune_ms = 0
    self.old_raw = nil
    self.st = nil
    self.l1 = self.s_off
    self.l2 = self.s_hint
    self.l2col = sf.GREY
    self.eqcol = sf.GREY
    self.toast = ""
    self.toast_until = 0

    self.load_chans()
    self.build_items()
    self.tick()
  end

  # ---------------------------------------------------------- channel list

  # Online list from store (refreshed daily) or the built-in table.
  def load_chans()
    var saved = store.get("chans")
    if isinstance(saved, list) && size(saved) > 0
      var out = []
      for r : saved
        out.push([r[0], r[1], r[2], sf.color(r[0])])
      end
      self.chans = out
      log("channel list: " + str(size(out)) + " from SomaFM, updated " + str(store.get("chans_day")))
    else
      self.chans = sf.CHANNELS
      log("channel list: " + str(size(sf.CHANNELS)) + " built-in")
    end
  end

  # At most once a day, when the knob is first used: fetch channels.json in the
  # background, used with SomaFM's permission and identified by sf.USER_AGENT.
  # Failures are silent; the stored or built-in list stays in use.
  def maybe_refresh()
    var y = year()
    if y < 0 return end                                  # clock not set yet
    var today = y * 10000 + month() * 100 + day()
    if store.get("chans_day") == today && store.get("chans") != nil return end
    var cap = 81920
    http.get("https://somafm.com/channels.json", def (body, status)
      if body == nil || status != 200
        log("channel refresh failed: " + str(status))
        return
      end
      if size(body) >= cap
        log("channel refresh: answer truncated, keeping old list")
        return
      end
      var rows = sf.parse_channels(body)
      if size(rows) < 10
        log("channel refresh: only " + str(size(rows)) + " channels parsed, ignored")
        return
      end
      store.set("chans", rows)
      store.set("chans_day", today)
      self.load_chans()
      self.build_items()
    end, {"cap": cap, "timeout": 15, "headers": {"User-Agent": sf.USER_AGENT}})
  end

  # The list: Radio off, favourites, then everything else. Stays on the same
  # item when the list changes.
  def build_items()
    var keep = self.items[self.cur]
    var items = [OFF_ITEM]
    for id : self.favs
      items.push(id)
    end
    for c : self.chans
      if sf.pos(self.favs, c[0]) < 0 items.push(c[0]) end
    end
    self.items = items
    var i = sf.pos(items, keep)
    self.cur = i < 0 ? 0 : i
  end

  # [title, genre, colour] for any id, also for ids missing from the list.
  def row_of(id)
    var i = sf.index_of(self.chans, id)
    if i >= 0
      var c = self.chans[i]
      return [c[1], c[2], c[3]]
    end
    return [sf.title(id), "off air", sf.color(id)]
  end

  def toggle_fav()
    var id = self.items[self.cur]
    if id == OFF_ITEM return end
    var i = sf.pos(self.favs, id)
    if i < 0
      self.favs.push(id)
    else
      self.favs.remove(i)
    end
    store.set("favs", self.favs)
    self.build_items()
  end

  # ------------------------------------------------------------ the radio

  # Channel id of the station, nil if none or not a SomaFM channel. The firmware
  # keeps reporting the station after a stop, so callers also check playing.
  def station_id()
    var st = music.station()
    if st != self.st
      self.st = st
      log("station: " + st)
    end
    return st != "" ? sf.id_from_station(st, self.chans) : nil
  end

  # What the radio is on now: a channel id, OFF_ITEM, or nil for another station.
  # A channel being tuned counts for up to 20 s, also while it fails to connect.
  def radio_item()
    var playing = music.playing()
    var id = playing ? self.station_id() : nil
    if self.tuned != nil && id != self.tuned && now_ms() - self.tune_ms < 20000
      return self.tuned
    end
    return playing ? id : OFF_ITEM
  end

  def tune(id)
    self.tuned = id
    self.tune_ms = now_ms()
    self.old_raw = music.title()
    if !sound.play({"station": sf.stream_url(id)})
      log("sound.play refused " + id)
      self.tuned = nil
      self.show_toast("can't play")
    end
  end

  def stop_radio()
    self.tuned = nil
    http.post("http://127.0.0.1/api/v1/audio/stop", "{\"group\":\"radio\"}",
      def (body, status)
        if status < 200 || status >= 300
          log("radio off failed, status " + str(status))
          self.show_toast("off failed")
        end
      end,
      {"headers": {"Content-Type": "application/json"}, "timeout": 5})
  end

  # Do what the list says, once the knob has been still for 600 ms.
  def commit()
    if self.zap_timer != nil
      timer.cancel(self.zap_timer)
      self.zap_timer = nil
    end
    var id = self.items[self.cur]
    if id == OFF_ITEM
      self.stop_radio()
    elif music.playing() && id == self.station_id()
      self.tuned = nil
    else
      self.tune(id)
    end
    self.tick()
  end

  def change_volume(delta)
    var v = settings.get("radioVolume")
    if v == nil v = self.vol end
    v += delta
    if v < 0 v = 0 end
    if v > 100 v = 100 end
    if !settings.set("radioVolume", v) log("radioVolume not accepted") end
    self.vol = v
  end

  def show_toast(msg)
    self.toast = settings.apply_case(msg)
    self.toast_until = now_ms() + 1500
    self.tick()
  end

  # ------------------------------------------------------------- the view

  # Work out the two lines. Runs once a second and after every input.
  def tick()
    if !self.active
      var i = sf.pos(self.items, self.radio_item())
      self.cur = i < 0 ? 0 : i
    end
    var id = self.items[self.cur]
    if id == OFF_ITEM
      self.l1 = self.s_off
      self.l2 = self.s_hint
      self.l2col = sf.GREY
      self.eqcol = sf.GREY
    else
      var r = self.row_of(id)
      self.l1 = settings.apply_case(r[0])
      self.eqcol = r[2]
      var raw = music.title()
      var on_air = music.playing() && self.station_id() == id
      if self.tuned == id
        # Tuned once the new station is on and the old stream's title is gone.
        if on_air && (raw != self.old_raw || now_ms() - self.tune_ms > 8000)
          self.tuned = nil
        else
          on_air = false
        end
      end
      if on_air && raw != ""
        self.l2 = settings.apply_case(raw)
        self.l2col = sf.WHITE
      elif self.tuned == id && now_ms() - self.tune_ms > 10000
        self.l2 = self.s_nosignal
        self.l2col = sf.GREY
      else
        self.l2 = settings.apply_case(r[1])
        self.l2col = sf.GREY
      end
    end
    if now_ms() < self.toast_until
      self.l2 = self.toast
      self.l2col = sf.AMBER
    end
  end

  # --------------------------------------------------------------- input

  def touch()
    if !self.active
      self.tick()               # start from what's on the radio now
      self.active = true
      self.maybe_refresh()
    end
    self.last_input = now_ms()
    rotation.pause()            # input can end a pause, so set it again
  end

  def on_knob(ev)
    self.touch()
    if ev == "left" || ev == "right"
      var dir = ev == "left" ? -1 : 1
      if self.vol_mode
        self.change_volume(dir * 5)
      else
        var n = size(self.items)
        self.cur = (self.cur + dir + n) % n
        if self.zap_timer != nil timer.cancel(self.zap_timer) end
        self.zap_timer = timer.after(600, / -> self.commit())
      end
    elif ev == "press"
      self.knob_long = false
    elif ev == "long"
      self.knob_long = true
      self.toggle_fav()
    elif ev == "release"
      if !self.knob_long
        self.vol_mode = !self.vol_mode
        var v = settings.get("radioVolume")
        if v != nil self.vol = v end
      end
      self.knob_long = false
    end
    self.tick()
    return true
  end

  def end_input()
    self.active = false
    self.vol_mode = false
    self.knob_long = false
    rotation.resume()
    self.tick()
  end

  # ---------------------------------------------------------------- hooks

  # Another station on the radio isn't ours to show.
  def should_show()
    if self.active return true end
    self.tick()
    if music.playing() && self.radio_item() == nil return false end
    return self.items[self.cur] != OFF_ITEM || self.idlecard
  end

  # Radio off only takes a short turn.
  def duration()
    return self.items[self.cur] == OFF_ITEM ? 4000 : 0
  end

  def on_show()
    self.tick()
  end

  def on_hide()
    if self.zap_timer != nil self.commit() end    # still tunes the last choice
    if self.active self.end_input() end
  end

  def loop()
    if self.active
      rotation.pause()
      var idle = now_ms() - self.last_input
      if idle > 2000 self.vol_mode = false end
      if idle > 5000 && self.zap_timer == nil self.end_input() end
    end
    self.tick()
  end

  def draw()
    clear()
    var w = width()
    sf.draw_now(self.l1, sf.AMBER, self.l2, self.l2col, self.eqcol, self.o1, self.o2)
    if !self.active return end
    if self.vol_mode
      rect_fill(0, 15, w, 1, sf.TRACK)
      rect_fill(0, 15, self.vol * w / 100, 1, sf.TEAL)
    else
      rect_fill(0, 15, w, 1, sf.TRACK)
      rect_fill(self.cur * (w - 3) / (size(self.items) - 1), 15, 3, 1, sf.AMBER)
    end
    if sf.pos(self.favs, self.items[self.cur]) >= 0
      rect_fill(w - 6, 0, 6, 7, 0x000000)
      sf.draw_star(w - 5, 1, sf.AMBER)
    end
  end
end

return SomaFM()
