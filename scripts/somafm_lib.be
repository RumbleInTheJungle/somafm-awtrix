  ["cliqhop", "cliqhop idm", "electronic", 0xFF9C22],
  ["covers", "Covers", "eclectic", 0xFF8E66],
  ["darkzone", "The Dark Zone", "ambient", 0x7A3CFF],
  ["deepspaceone", "Deep Space One", "ambient", 0x0092FF],
  ["defcon", "DEF CON Radio", "electronic", 0xFF058F],
  ["deptstore", "Department Store Christmas", "holiday", 0xFF7E44],
  ["digitalis", "Digitalis", "electronic", 0xFFBB3F],
  ["doomed", "Doomed", "ambient", 0xB4B4B4],
  ["dronezone", "Drone Zone", "ambient", 0x659EFF],
  ["dz2", "Drone Zone 2", "ambient", 0x669DFF],
  ["dubstep", "Dub Step Beyond", "electronic", 0x3F15FF],
  ["fluid", "Fluid", "electronic", 0xB4B4B4],
  ["folkfwd", "Folk Forward", "folk", 0xFF9866],
  ["groovesalad", "Groove Salad", "ambient", 0x5CFF39],
  ["groovesalad2", "Groove Salad 2", "ambient", 0x78FF5D],
