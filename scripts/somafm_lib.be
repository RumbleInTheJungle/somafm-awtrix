  ["reggae", "Heavyweight Reggae", "reggae", 0xFF2924],
  ["illstreet", "Illinois Street Lounge", "lounge", 0x55D4FF],
  ["insound", "The In-Sound", "oldies", 0xFF7428],
  ["indiepop", "Indie Pop Rocks!", "alternative", 0xFFE040],
  ["jollysoul", "Jolly Ol' Soul", "holiday", 0xFF1C29],
  ["seventies", "Left Coast 70s", "70s", 0x4D6EFF],
  ["lush", "Lush", "electronic", 0xFF5FA0],
  ["metal", "Metal Detector", "metal", 0xFF0B13],
  ["missioncontrol", "Mission Control", "ambient", 0xFF9666],
  ["n5md", "n5MD Radio", "specials", 0xB4B4B4],
  ["poptron", "PopTron", "alternative", 0x00CBFF],
  ["secretagent", "Secret Agent", "lounge", 0xFF6A00],
  ["7soul", "Seven Inch Soul", "oldies", 0xFFBE3A],
  ["sf1033", "SF 10-33", "ambient", 0x00FF4D],
  ["sfinsf", "SF in SF", "spoken", 0xFF594E],
  ["scanner", "SF Police Scanner", "live", 0x00FF4D],
  ["live", "SomaFM Live", "live", 0xFF6C66],
  ["specials", "SomaFM Specials", "specials", 0xFF7C55],
  ["sonicuniverse", "Sonic Universe", "jazz", 0xFF8235],
  ["spacestation", "Space Station Soma", "electronic", 0xFF9D5C],
  ["suburbsofgoa", "Suburbs of Goa", "world", 0xFFBF0E],
