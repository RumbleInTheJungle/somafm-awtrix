# @module  somafm_lib
# @name    SomaFM library
# @desc    Do not install this script directly. Install SomaFM Radio to get the whole package: https://awtrix.de/script/lR85BD2PCMjm
# @author  Thomas
# @version 1.2.0
# @display 52x16
#
# Unofficial hobby project, not affiliated with or endorsed by SomaFM but used
# with their permission. SomaFM's streams and JSON files are not a free data
# feed, and the permission doesn't carry over to forks or other projects. Read
# their terms first: https://somafm.com/contact/tos.html (see also NOTICE.md).

import string

var m = module("somafm_lib")

# ---------------------------------------------------------------------------
# Identifies this project to SomaFM, at their request, so it doesn't get blocked
# by mistake. IF YOU FORK THIS CODE, change it to your own project's name and
# address, and get your own permission from SomaFM.
# ---------------------------------------------------------------------------
m.USER_AGENT = "somafm-awtrix/1.2 (+https://github.com/RumbleInTheJungle/somafm-awtrix)"

# ---------------------------------------------------------------------------
# Palette: SomaFM's web colours (black, #EEE, amber #D8A24D, teal #1A9096),
# pushed a little more saturated so they don't wash out to beige on LEDs.
# ---------------------------------------------------------------------------
m.WHITE = 0xEBEBEB   # primary text: channel names, song titles
m.AMBER = 0xFFA830   # accent: channel name (now playing), "playing", favourites, cursor
m.TEAL  = 0x20B8C0   # secondary accent: volume / system feedback
m.GREY  = 0x6E6E6E   # secondary text: genre, "tuning", "retrying"
m.TRACK = 0x202020   # inactive track of the position / volume bar
m.OFF   = 0xB4B4B4   # colour bar for channels without a signature colour

# BEGIN CHANNELS
# Generated by tools/gen_channels.py on 2026-11-04 (51 channels). Do not edit by hand.
# [id, title, genre, signature colour]
m.CHANNELS = [
  ["beatblender", "Beat Blender", "electronic", 0xF434FF],
  ["brfm", "Black Rock FM", "eclectic", 0xFF9B66],
  ["bootliquor", "Boot Liquor", "americana", 0xFF7C31],
  ["bossa", "Bossa Beyond", "bossanova", 0xFF833C],
